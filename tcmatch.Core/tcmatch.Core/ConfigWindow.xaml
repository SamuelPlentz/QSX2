                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <HeaderedContentControl Grid.Row="0" Style="{StaticResource InfoBannerStyle}" Margin="0,0,0,0">
                            <Grid>
                                <TextBlock Text="{Binding viewPersonalCurrentLanguage}" d:Text="German" FontWeight="SemiBold"/>
                                <Button Content="{Binding viewPersonalToggleLanguage_NewLanguage}" d:Content="Switch to &quot;English&quot;" Visibility="{Binding viewPersonalToggleLanguage_Visibility}" HorizontalAlignment="Right" Click="PersonalToggleLanguage_Click" Style="{StaticResource PrimaryButtonStyle}"/>
                            </Grid>
                        </HeaderedContentControl>

                        <wv2:WebView2 Grid.Row="1" Name="PersonalWebView" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    </Grid>
                </TabItem>

            </TabControl>

            <Grid Grid.Row="1" Margin="0,8,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <HeaderedContentControl Grid.Row="0" Style="{StaticResource WarningBannerStyle}" Visibility="{Binding viewWarningBannerVisibility}" Margin="0,5,0,5">
                    <TextBlock Text="{Binding viewWarningBannerText}"/>
                </HeaderedContentControl>

                <HeaderedContentControl Grid.Row="1" Style="{StaticResource ErrorBannerStyle}" Visibility="{Binding viewErrorBannerVisibility}" Margin="0,5,0,5">
                    <TextBlock Text="{Binding viewErrorBannerText}"/>
                </HeaderedContentControl>

                <Grid Grid.Row="2" Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="{Binding L[001_002_001]}" d:Content="Defaults" Click="ResetDefaults_Click" />

                    <Button Grid.Column="2" Content="{Binding L[001_002_002]}" d:Content="Cancel" Margin="0,0,8,0" Click="Cancel_Click" Style="{StaticResource DangerButtonStyle}" />

                    <Button Grid.Column="3" Content="{Binding L[001_002_003]}" d:Content="Save &amp; Close" Click="SaveButton_Click" IsDefault="True" IsEnabled="{Binding isSaveEnabled}" Style="{StaticResource PrimaryButtonStyle}"/>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</ui:FluentWindow>